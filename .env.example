# Production uses the strict settings profile. Do not place real secrets here.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=orders.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://orders.example.com
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

DATABASE_HOST=db.example.internal
DATABASE_PORT=5432
DATABASE_NAME=hospital_orders
DATABASE_USER=hospital_user
DATABASE_PASSWORD=replace-with-database-password
DATABASE_CONN_MAX_AGE=60

# Mount durable shared storage here in the web and OCR containers.
MEDIA_ROOT=/app/media
# Host-side mount used by docker-compose.production.yml (example only).
MEDIA_ROOT_HOST=/data/acoeurs-orders/media
MAX_PDF_UPLOAD_SIZE=26214400
ACOEUR_IMAGE=acoeurs-orders:staging
WEB_PORT=8000

ACOEUR_OCR_SERVICE_URL=http://ocr:8765/ocr
ACOEUR_OCR_SERVICE_TIMEOUT=1800
ACOEUR_OCR_HOST=0.0.0.0
ACOEUR_OCR_PORT=8765
ACOEUR_CONTAINER_MEDIA_ROOT=/app/media
ACOEUR_HOST_MEDIA_ROOT=/app/media
ACOEUR_OCR_LANG=fr
ACOEUR_OCR_ZOOM=2.0
ACOEUR_OCR_DET_LIMIT_TYPE=max
ACOEUR_OCR_DET_LIMIT_SIDE_LEN=960
