msgstr "PDF 暂时无法生成，请重试。"

msgid "Invoice/PO references longer than 180 characters are abbreviated with [...]. Complete references remain in XLSX."
msgstr "Invoice / PO 编号超过 180 个字符时以 [...] 明示缩写；完整编号请查看 XLSX。"

