{% extends "portal/base.html" %}
{% load static %}

{% block title %}{{ page_title }} | 文档中心{% endblock %}

{% block extra_css %}
<link rel="stylesheet"
      href="{% static 'portal/css/document_center.css' %}">
{% endblock %}

{% block breadcrumb %}
<nav class="document-breadcrumb">
    <a href="{% url 'portal:home' %}">
        首页
    </a>

    <span>›</span>

    <a href="{% url 'portal:document_center' %}">
        文档中心
    </a>

    <span>›</span>

    <span>{{ page_title }}</span>
</nav>
{% endblock %}

{% block content %}
<section class="portal-page-header">
    <div>
        <h1>{{ page_title }}</h1>

        <p>{{ page_description }}</p>
    </div>

    <div class="portal-header-actions">
        <a class="portal-button"
           href="{{ document_home_url }}">
            返回文档分类
        </a>

        {% if fixed_document_type %}
            <a class="portal-button"
               href="{% url 'portal:document_list' %}">
                查看全部
            </a>
        {% endif %}
    </div>
</section>

<section class="document-stat-grid">
    <div class="document-stat-card">
        <span>全部文档</span>
        <strong>{{ total_count }}</strong>
    </div>

    <div class="document-stat-card">
        <span>Hospital Invoice</span>
        <strong>{{ invoice_count }}</strong>
    </div>

    <div class="document-stat-card">
        <span>Factory PO</span>
        <strong>{{ po_count }}</strong>
    </div>

    <div class="document-stat-card">
        <span>Factory Request</span>
        <strong>{{ request_count }}</strong>
    </div>

    <div class="document-stat-card">
        <span>本月生成</span>
        <strong>{{ this_month_count }}</strong>
    </div>
</section>

<section class="document-filter-panel">
    <form method="get"
          class="document-filter-form {% if fixed_document_type %}fixed-document-type{% endif %}">

        <div class="document-filter-search">
            <label for="document-search">
                搜索
            </label>

            <input
                id="document-search"
                type="search"
                name="q"
                value="{{ query }}"
                placeholder="文档编号、订单号、医院或工厂"
            >
        </div>

        {% if not fixed_document_type %}
            <div>
                <label for="document-type">
                    文档类型
                </label>

                <select
                    id="document-type"
                    name="type">

                    <option value="all"
                            {% if document_type == "all" %}selected{% endif %}>
                        全部类型
                    </option>

                    {% for value, label in document_type_choices %}
                        <option
                            value="{{ value }}"
                            {% if document_type == value %}
                                selected
                            {% endif %}>
                            {{ label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}

        <div>
            <label for="document-month">
                月份
            </label>

            <select
                id="document-month"
                name="month">

                <option value="">
                    全部月份
                </option>

                {% for option in month_options %}
                    <option
                        value="{{ option }}"
                        {% if month_key == option %}
                            selected
                        {% endif %}>
                        {{ option }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div>
            <label for="document-file">
                PDF
            </label>

            <select
                id="document-file"
                name="file_status">

                <option value="all"
                        {% if file_status == "all" %}selected{% endif %}>
                    全部
                </option>

                <option value="has_pdf"
                        {% if file_status == "has_pdf" %}selected{% endif %}>
                    有 PDF 记录
                </option>

                <option value="missing_pdf"
                        {% if file_status == "missing_pdf" %}selected{% endif %}>
                    无 PDF 记录
                </option>
            </select>
        </div>

        <div>
            <label for="date-from">
                开始日期
            </label>

            <input
                id="date-from"
                type="date"
                name="date_from"
                value="{{ date_from }}"
            >
        </div>

        <div>
            <label for="date-to">
                结束日期
            </label>

            <input
                id="date-to"
                type="date"
                name="date_to"
                value="{{ date_to }}"
            >
        </div>

        <div class="document-filter-actions">
            <button
                class="portal-button primary"
                type="submit">
                查询
            </button>

            <a class="portal-button"
               href="{% url 'portal:document_center' %}">
                重置
            </a>
        </div>
    </form>
</section>

<div class="portal-table-wrap">
    <table class="portal-table document-table">
        <thead>
            <tr>
                <th>文档编号</th>
                <th>类型</th>
                <th>医院订单</th>
                <th>医院 / 工厂</th>
                <th>批次</th>
                <th>金额</th>
                <th>文件</th>
                <th>生成时间</th>
                <th>生成人</th>
            </tr>
        </thead>

        <tbody>
            {% for document in page_obj %}
                <tr>
                    <td>
                        <a class="document-number-link"
                           href="{% url 'portal:document_detail' document.id %}">
                            {{ document.document_number }}
                        </a>
                    </td>

                    <td>
                        <span class="document-type-pill {{ document.portal_type_class }}">
                            {{ document.portal_type_label }}
                        </span>
                    </td>

                    <td>
                        <a href="{% url 'portal:order_detail' document.order_id %}">
                            {{ document.order.bon_de_commande }}
                        </a>
                    </td>

                    <td>
                        <strong>
                            {{ document.portal_hospital_label }}
                        </strong>

                        <div class="document-muted">
                            {{ document.portal_factory_label }}
                        </div>
                    </td>

                    <td>
                        {% if document.shipment_batch %}
                            Batch
                            {{ document.shipment_batch.batch_number }}
                        {% else %}
                            —
                        {% endif %}
                    </td>

                    <td class="document-amount">
                        {% if document.portal_amount is not None %}
                            €{{ document.portal_amount|floatformat:2 }}
                        {% else %}
                            —
                        {% endif %}
                    </td>

                    <td>
                        <div class="document-file-status">
                            {% if document.portal_pdf.name %}
                                {% if document.portal_pdf.exists %}
                                    <a href="{{ document.portal_pdf.url }}"
                                       target="_blank"
                                       rel="noopener">
                                        PDF
                                    </a>
                                {% else %}
                                    <span class="missing">
                                        PDF 缺失
                                    </span>
                                {% endif %}
                            {% else %}
                                <span>无 PDF</span>
                            {% endif %}

                            {% if document.portal_html.name %}
                                {% if document.portal_html.exists %}
                                    <a href="{{ document.portal_html.url }}"
                                       target="_blank"
                                       rel="noopener">
                                        HTML
                                    </a>
                                {% else %}
                                    <span class="missing">
                                        HTML 缺失
                                    </span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </td>

                    <td>
                        {{ document.generated_at|date:"Y-m-d H:i" }}
                    </td>

                    <td>
                        {{ document.generated_by.get_full_name|default:document.generated_by.username }}
                    </td>
                </tr>
            {% empty %}
                <tr>
                    <td colspan="9"
                        class="portal-empty">
                        没有找到符合条件的文档。
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if page_obj.paginator.num_pages > 1 %}
<nav class="document-pagination">
    {% if page_obj.has_previous %}
        <a href="?{% if query_without_page %}{{ query_without_page }}&{% endif %}page={{ page_obj.previous_page_number }}">
            上一页
        </a>
    {% endif %}

    <span>
        第 {{ page_obj.number }} 页，
        共 {{ page_obj.paginator.num_pages }} 页
    </span>

    {% if page_obj.has_next %}
        <a href="?{% if query_without_page %}{{ query_without_page }}&{% endif %}page={{ page_obj.next_page_number }}">
            下一页
        </a>
    {% endif %}
</nav>
{% endif %}
{% endblock %}
