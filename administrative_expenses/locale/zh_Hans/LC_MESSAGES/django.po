msgstr "已支付"

msgid "Employee / payee is required for this category."
msgstr "工资、福利和报销必须填写员工或经办人。"

msgid "Paid expenses require a payment date."
msgstr "已支付费用必须填写付款日期。"

msgid "Pending expenses cannot have a payment date."
msgstr "待支付费用不能填写付款日期。"

msgid "Payment date must be on or after the expense date and cannot be in the future."
msgstr "付款日期不得早于费用发生日期，也不能晚于今天。"

msgid "Supporting document attached"
msgstr "已上传凭证"

msgid "Missing supporting document"
msgstr "待补凭证"

