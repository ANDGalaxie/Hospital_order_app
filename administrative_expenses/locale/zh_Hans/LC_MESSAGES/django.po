msgstr "凭证类型"

msgid "Attachments / Justificatifs"
msgstr "附件 / Justificatifs"

msgid "Only PDF, JPG, JPEG and PNG files with safe filenames are allowed."
msgstr "仅允许文件名安全的 PDF、JPG、JPEG 和 PNG 文件。"

msgid "Each file must be non-empty and no larger than 10 MB."
msgstr "单个文件不得为空，且不得超过 10 MB。"

msgid "The file content does not match a valid supported document format."
msgstr "文件实际内容与有效的支持格式不符。"

msgid "The total upload size cannot exceed 25 MB."
msgstr "单次上传总大小不得超过 25 MB。"

msgid "Choose a valid month (YYYY-MM)."
msgstr "请选择有效月份（YYYY-MM）。"

msgid "Invalid document type."
msgstr "无效凭证类型。"

msgid "Voided expenses cannot be edited."
msgstr "作废费用不可编辑。"

msgid "Invalid filter."
msgstr "无效筛选条件。"

msgid "Unable to save. Existing records and attachments have been preserved; please try again."
msgstr "保存失败，原有记录和附件已保留，请重试。"

msgid "Expense saved."
msgstr "费用已保存。"

msgid "Unable to upload attachments; please try again."
msgstr "附件上传失败，请重试。"

msgid "Attachments uploaded."
msgstr "凭证已上传。"

msgid "Choose at least one file."
msgstr "请选择至少一个文件。"

msgid "Unable to remove attachment; please try again."
msgstr "移除附件失败，请重试。"

msgid "Attachment removed."
msgstr "附件已移除。"

msgid "Attachment removed from this expense. Private storage cleanup is pending."
msgstr "附件已从费用中移除，私有存储清理待重试。"

